# The Lenny Growth Assistant — environment configuration
#
# Copy to `.env` (`cp .env.example .env`) and adjust. Docker Compose reads this
# file automatically; the backend also reads it when run directly from
# `backend/` (see backend/app/config.py).
#
# REQUIRED  = the stack will not work without it (defaults below are usable as-is)
# OPTIONAL  = only needed for a specific path (cloud providers, tuning)
# No real secrets are committed here.

# ---------------------------------------------------------------- app (REQUIRED)
ENVIRONMENT=local
LOG_LEVEL=INFO
# Origins allowed to call the API from a browser. Add your frontend origin.
CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# ----------------------------------------------------------- database (REQUIRED)
# Compose builds this URL for the backend container itself; this value is what
# you use when running the backend or the ingestion CLI on the host.
DATABASE_URL=postgresql+psycopg://lenny:lenny@localhost:5432/lenny
POSTGRES_USER=lenny
POSTGRES_PASSWORD=lenny
POSTGRES_DB=lenny
POSTGRES_PORT=5432

# ------------------------------------------------------------- ports (OPTIONAL)
BACKEND_PORT=8000
FRONTEND_PORT=8080

# ------------------------------------------------- model provider (REQUIRED)
# ollama (default, fully local) | anthropic | openai
LLM_PROVIDER=ollama
# Ollama example: llama3.2:1b (CPU/lightweight) | llama3.1:8b (GPU)
# Anthropic example: claude-sonnet-4-20250514
# OpenAI example: gpt-4o-mini
LLM_MODEL=llama3.2:1b
LLM_TIMEOUT_SECONDS=300
LLM_MAX_OUTPUT_TOKENS=4096
LLM_TEMPERATURE=0.2

# ------------------------------------------------------------ ollama (REQUIRED
# for the default local path; ignored when LLM_PROVIDER is a cloud provider,
# except for embeddings, which always use Ollama)
# From inside Docker Compose (default): http://host.docker.internal:11434
# When running backend on host:         http://localhost:11434
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# ----------------------------------------------------- cloud providers (OPTIONAL)
# Required only when LLM_PROVIDER=anthropic / openai. Leave empty otherwise.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# ------------------------------------------------------ agent runtime (OPTIONAL)
# auto       -> Claude Agent SDK when it is installed and the provider is anthropic
# claude_sdk -> always the Claude Agent SDK runtime (requires ANTHROPIC_API_KEY)
# local      -> always the local tool-loop runtime (same tools, prompts, grounding)
AGENT_RUNTIME=auto
AGENT_MAX_TOOL_STEPS=6

# -------------------------------------------------------- embeddings (REQUIRED)
# nomic-embed-text = 768 dimensions
EMBEDDING_PROVIDER=ollama
EMBEDDING_DIMENSIONS=768

# --------------------------------------------------------- retrieval (OPTIONAL)
RETRIEVAL_TOP_K=4
RETRIEVAL_CANDIDATE_MULTIPLIER=4
# Cosine-similarity floor. Below it, the assistant refuses instead of guessing.
RETRIEVAL_SCORE_THRESHOLD=0.48
RETRIEVAL_MIN_CHUNKS_FOR_ANSWER=1
# none | lexical
RETRIEVAL_RERANKER=lexical

# --------------------------------------------------------- ingestion (REQUIRED)
TRANSCRIPTS_PATH=./data/transcripts
CHUNK_TARGET_CHARS=1400
CHUNK_OVERLAP_CHARS=200

# --------------------------------------------------------- artifacts (OPTIONAL)
ARTIFACT_MAX_BYTES=200000

# ---------------------------------------------------------- frontend (REQUIRED)
# Browser-visible base URL of the FastAPI backend.
VITE_API_BASE_URL=http://localhost:8000

# ------------------------------------------------------------- tests (OPTIONAL)
# Point the DB-backed test suite at a throwaway PostgreSQL to run the pgvector
# retrieval tests. Without it those tests skip; all others still run on SQLite.
# TEST_DATABASE_URL=postgresql+psycopg://lenny:lenny@localhost:5432/lenny_test
